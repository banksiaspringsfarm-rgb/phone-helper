<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the fake Claude call sets the audio mode (FakeCall, debug only) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application>
        <!-- adb test hook, debug builds only: only the shell (which holds DUMP) can send it. -->
        <receiver android:name=".DebugReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="local.phonehelper.TEST" /></intent-filter>
        </receiver>
    </application>
</manifest>
